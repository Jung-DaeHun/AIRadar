{
  "enabledPlugins": {
    "harness@harness-marketplace": true,
    "superpowers@claude-plugins-official": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [{ "type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/tdd_guard.py\"" }]
      },
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/bash_guard.py\"" }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop_tests.py\"", "timeout": 180 }]
      }
    ]
  }
}
